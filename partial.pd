#N canvas 0 0 820 520 12;
#X text 20 10 One partial. \$1 = slot 1-129 (set by clone): slots 1-64 are subharmonics 1/65 ... 1/2 \, slot 65 is the root \, slots 66-129 are harmonics 2x ... 65x. \$2 = the voice's \$0 \, used to receive its note frequency. Level and pan are read from the amps \, panL and panR arrays whenever tick-\$1 arrives (the main patch cycles through the slots about every 26 ms \, a few at a time so the work is spread out) and smoothed in between.;
#X obj 20 90 r \$2-freq;
#X obj 20 120 expr if(\$1 < 65 \, 1.0/(66 - \$1) \, \$1 - 64) * \$f1;
#X obj 20 150 t f f;
#X obj 20 400 osc~;
#X obj 140 180 expr (\$f1 > 20) * (\$f1 < 18000);
#X obj 400 90 r tick-\$1;
#X obj 400 120 expr \$1 - 1;
#X obj 400 150 t f f f;
#X obj 400 190 tabread amps;
#X obj 520 220 tabread panL;
#X obj 640 250 tabread panR;
#X obj 400 290 expr \$f1 * \$f2 * \$f4 \; \$f1 * \$f3 * \$f4;
#X msg 400 330 \$1 30;
#X msg 560 330 \$1 30;
#X obj 400 360 line~;
#X obj 560 360 line~;
#X obj 20 440 *~;
#X obj 160 440 *~;
#X obj 20 480 outlet~;
#X obj 160 480 outlet~;
#X obj 140 210 t b f;
#X text 140 240 audible-range gate (mute below 20 Hz and above 18 kHz);
#X text 400 60 left / right level = level x pan x gate;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 3 1 5 0;
#X connect 5 0 21 0;
#X connect 21 1 12 3;
#X connect 21 0 7 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 2 11 0;
#X connect 8 1 10 0;
#X connect 8 0 9 0;
#X connect 9 0 12 0;
#X connect 10 0 12 1;
#X connect 11 0 12 2;
#X connect 12 0 13 0;
#X connect 12 1 14 0;
#X connect 13 0 15 0;
#X connect 14 0 16 0;
#X connect 4 0 17 0;
#X connect 4 0 18 0;
#X connect 15 0 17 1;
#X connect 16 0 18 1;
#X connect 17 0 19 0;
#X connect 18 0 20 0;
