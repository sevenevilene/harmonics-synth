#N canvas 0 0 1000 700 12;
#X text 20 10 One partial. \$1 = slot 1-129 (set by clone). \$2 = the voice's \$0. The voice sends "freq S" where S is how many of its 129 slots are subharmonics for this note (more for high notes \, fewer for low notes). Slots 1..S are subharmonics 1/(S+1) ... 1/2 \, slot S+1 is the root \, the rest are harmonics 2x \, 3x ... So the root moves with the note. Level and pan are read from the 257-slot amps \, panL and panR arrays (root = index 128) on every tick-\$1 and on every new note \, and smoothed in between: 30 ms normally \, or with glide on \, rising values take the attack time and falling ones the release time \, and each new note starts every partial from 0.;
#X obj 20 110 r \$2-freq;
#X obj 20 140 unpack f f;
#X obj 200 170 expr \$1 - $f1 - 1;
#X obj 200 200 t f f;
#X obj 200 240 expr if($f1 < 0 \, 1/(1 - $f1) \, $f1 + 1);
#X obj 320 240 + 128;
#X obj 20 280 *;
#X obj 20 310 t f f;
#X obj 20 450 osc~;
#X obj 140 340 expr ($f1 > 20) * ($f1 < 18000);
#X obj 140 370 t b f;
#X obj 460 110 r tick-\$1;
#X obj 460 280 f;
#X obj 460 310 t f f f;
#X obj 460 340 tabread amps;
#X obj 580 370 tabread panL;
#X obj 700 400 tabread panR;
#X obj 460 430 expr $f1 * $f2 * $f4;
#X obj 460 460 change;
#X obj 620 460 change;
#X obj 460 580 line~;
#X obj 620 580 line~;
#X obj 20 620 *~;
#X obj 160 620 *~;
#X obj 20 650 outlet~;
#X obj 160 650 outlet~;
#X text 200 140 offset from the root (negative = subharmonic) -> ratio and array index;
#X text 140 400 audible-range gate (mute below 20 Hz and above 18 kHz);
#X obj 460 490 t f f f;
#X obj 500 520 expr if($f3 == 0 \, 30 \, if($f1 > $f2 \, $f4 \, $f5));
#X obj 460 550 pack f f;
#X obj 620 490 t f f f;
#X obj 660 520 expr if($f3 == 0 \, 30 \, if($f1 > $f2 \, $f4 \, $f5));
#X obj 620 550 pack f f;
#X obj 700 200 r glide;
#X obj 770 200 r attack;
#X obj 850 200 r release;
#X obj 700 110 r \$2-on;
#X obj 700 140 spigot;
#X obj 700 170 t b b;
#X msg 780 250 0;
#X msg 830 250 set 0;
#X text 700 60 glide on: a new note resets every level to 0 \, then re-reads the graphs so they ramp up over the attack time;
#X obj 540 280 spigot 1;
#X obj 700 300 t b b b;
#X msg 760 330 1;
#X obj 860 110 r \$2-off;
#X obj 860 140 spigot;
#X obj 860 170 t b b;
#X msg 900 200 0;
#X obj 860 230 f;
#X msg 860 260 0 \$1;
#X obj 500 442 expr $f1 * $f3 * $f4;
#X obj 420 418 t f f;
