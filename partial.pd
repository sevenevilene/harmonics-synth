#N canvas 0 0 860 560 12;
#X text 20 10 One partial. \$1 = slot 1-129 (set by clone). \$2 = the voice's \$0. The voice sends "freq S" where S is how many of its 129 slots are subharmonics for this note (more for high notes \, fewer for low notes). Slots 1..S are subharmonics 1/(S+1) ... 1/2 \, slot S+1 is the root \, the rest are harmonics 2x \, 3x ... So the root moves with the note. Level and pan are read from the 257-slot amps \, panL and panR arrays (root = index 128) on every tick-\$1 and on every new note \, and smoothed in between.;
#X obj 20 110 r \$2-freq;
#X obj 20 140 unpack f f;
#X obj 200 170 expr \$1 - \$f1 - 1;
#X obj 200 200 t f f;
#X obj 200 240 expr if(\$f1 < 0 \, 1/(1 - \$f1) \, \$f1 + 1);
#X obj 320 240 + 128;
#X obj 20 280 *;
#X obj 20 310 t f f;
#X obj 20 450 osc~;
#X obj 140 340 expr (\$f1 > 20) * (\$f1 < 18000);
#X obj 140 370 t b f;
#X obj 460 110 r tick-\$1;
#X obj 460 280 f;
#X obj 460 310 t f f f;
#X obj 460 340 tabread amps;
#X obj 580 370 tabread panL;
#X obj 700 400 tabread panR;
#X obj 460 430 expr \$f1 * \$f2 * \$f4 \; \$f1 * \$f3 * \$f4;
#X msg 460 460 \$1 30;
#X msg 620 460 \$1 30;
#X obj 460 490 line~;
#X obj 620 490 line~;
#X obj 20 490 *~;
#X obj 160 490 *~;
#X obj 20 520 outlet~;
#X obj 160 520 outlet~;
#X text 200 140 offset from the root (negative = subharmonic) -> ratio and array index;
#X text 140 400 audible-range gate (mute below 20 Hz and above 18 kHz);
#X connect 1 0 2 0;
#X connect 2 1 3 0;
#X connect 3 0 4 0;
#X connect 4 1 6 0;
#X connect 6 0 13 1;
#X connect 4 0 5 0;
#X connect 5 0 7 1;
#X connect 2 0 7 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 8 1 10 0;
#X connect 10 0 11 0;
#X connect 11 1 18 3;
#X connect 11 0 13 0;
#X connect 12 0 13 0;
#X connect 13 0 14 0;
#X connect 14 0 15 0;
#X connect 14 1 16 0;
#X connect 14 2 17 0;
#X connect 15 0 18 0;
#X connect 16 0 18 1;
#X connect 17 0 18 2;
#X connect 18 0 19 0;
#X connect 18 1 20 0;
#X connect 19 0 21 0;
#X connect 20 0 22 0;
#X connect 9 0 23 0;
#X connect 9 0 24 0;
#X connect 21 0 23 1;
#X connect 22 0 24 1;
#X connect 23 0 25 0;
#X connect 24 0 26 0;
