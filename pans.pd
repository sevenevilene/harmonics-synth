#N canvas 0 0 900 640 12;
#X text 20 10 Pan curve engine: writes the panL and panR arrays (257 slots \, root = index 128) from a formula. d = distance from the root in slots (negative = subharmonic). x = stereo position (-1 left \, 0 centre \, 1 right) = spread * tanh(d / reach) for "spread" \, or with every other partial flipped for "alternate". "log" keeps the bass in the centre: every subharmonic \, the root and its octave (n = 1 and 2 \, where n = |d| + 1) in the centre and then widens evenly per octave: x = spread * log(n/2) / log(reach/2) \, full width from harmonic number reach (min 4) outwards. All subharmonics stay in the centre \, and the harmonics alternate: odd ones (3 \, 5 \, 7 ...) left \, even ones (4 \, 6 ...) right. "log-side" is the same \, but every harmonic goes to the right (left with a negative spread). Equal-power pan law: left = cos((x+1) * pi/4) \, right = sin((x+1) * pi/4) \, so a centred partial is 0.71 in both speakers \, a fully panned one is 1 and 0 \, and the loudness stays about the same wherever a partial sits. Sliders only redraw while a curve is selected \, so pans you drew by hand are kept.;
#X obj 20 110 r pancurve;
#X obj 20 140 route spread alternate centre log log-side;
#X msg 20 170 1;
#X msg 70 170 2;
#X obj 240 170 t b b;
#N canvas 100 100 450 320 centre-pans 0;
#X text 20 10 writes 0.7071 (equal-power centre) into every slot of panL and panR;
#X obj 20 40 inlet;
#X obj 20 70 t b b;
#X msg 20 100 257;
#X msg 120 100 0;
#X obj 20 130 until;
#X obj 20 160 f;
#X obj 70 160 + 1;
#X obj 20 190 t f f;
#X msg 20 220 0.7071;
#X obj 20 260 tabwrite panL;
#X obj 200 260 tabwrite panR;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 2 1 4 0;
#X connect 3 0 5 0;
#X connect 4 0 6 1;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 6 1;
#X connect 6 0 8 0;
#X connect 8 1 10 1;
#X connect 8 1 11 1;
#X connect 8 0 9 0;
#X connect 9 0 10 0;
#X connect 9 0 11 0;
#X restore 240 260 pd centre-pans;
#X msg 300 200 0;
#X obj 20 200 t b f;
#X obj 300 230 s panmode;
#X obj 500 110 r spread;
#X obj 500 140 t b f;
#X obj 620 110 r reach;
#X obj 620 140 t b f;
#X obj 500 190 f;
#X obj 500 220 moses 1;
#X obj 540 250 b;
#X obj 20 320 t b b;
#X msg 20 350 257;
#X obj 20 380 until;
#X obj 20 410 f;
#X obj 70 410 + 1;
#X msg 120 350 0;
#X obj 20 440 t f f;
#X obj 20 470 expr $f1 - 128;
#X obj 20 500 expr $f3 * if($f2 >= 3 \, if($f1 < 0 \, 0 \, if($f2 == 3 \, fmod($f1 \, 2)*2 - 1 \, 1)) * min(1 \, max(0 \, log((abs($f1) + 1)/2)) / log(max($f4 \, 4)/2)) \, tanh(if($f2 == 1 \, $f1 \, abs($f1)) / max($f4 \, 1)) * if($f2 == 1 \, 1 \, fmod(abs($f1) \, 2)*2 - 1));
#X obj 20 530 expr cos(($f1 + 1) * 0.785398);
#X obj 20 580 tabwrite panL;
#X obj 200 580 tabwrite panR;
#X text 20 290 fill: compute every slot;
#X msg 120 170 3;
#X msg 160 170 4;
#X obj 550 165 r panmode;
#X obj 60 542 expr sin(($f1 + 1) * 0.785398);
#X obj -20 518 t f f;
