#N canvas 100 100 900 600 12;
#X text 20 10 plugdata only: exposes the controls to the DAW (Logic etc.) as automation parameters. Moving a slider updates the DAW \, and DAW automation moves the slider. In plain Pd the param objects cannot be created \, which is harmless.;
#X obj 20 70 loadbang;
#X obj 20 110 r attack;
#X msg 110 110 create 10 1 2000 \, mode 3;
#X obj 20 150 param Attack;
#X obj 20 180 s attack-in;
#X obj 310 110 r release;
#X msg 400 110 create 300 5 5000 \, mode 3;
#X obj 310 150 param Release;
#X obj 310 180 s release-in;
#X obj 600 110 r master;
#X msg 690 110 create 0.7 0 1 \, mode 1;
#X obj 600 150 param Volume;
#X obj 600 180 s master-in;
#X obj 20 240 r subs;
#X msg 110 240 create 0.5 0 1 \, mode 1;
#X obj 20 280 param Subs;
#X obj 20 310 s subs-in;
#X obj 310 240 r tilt;
#X msg 400 240 create 1 0 3 \, mode 1;
#X obj 310 280 param Tilt;
#X obj 310 310 s tilt-in;
#X obj 600 240 r center;
#X msg 690 240 create 8 1 32 \, mode 1;
#X obj 600 280 param Center;
#X obj 600 310 s center-in;
#X obj 20 370 r width;
#X msg 110 370 create 2 0.5 8 \, mode 1;
#X obj 20 410 param Width;
#X obj 20 440 s width-in;
#X obj 310 370 r speed;
#X msg 400 370 create 1 0 4 \, mode 1;
#X obj 310 410 param Speed;
#X obj 310 440 s speed-in;
#X obj 600 370 r animate;
#X msg 690 370 create 0 0 1 \, mode 2;
#X obj 600 410 param Animate;
#X obj 600 440 s animate-in;
#X obj 20 480 r spread;
#X msg 110 480 create 0.8 -1 1 \, mode 1;
#X obj 20 510 param Spread;
#X obj 20 540 s spread-in;
#X obj 310 480 r reach;
#X msg 400 480 create 16 1 64 \, mode 1;
#X obj 310 510 param Reach;
#X obj 310 540 s reach-in;
#X obj 600 480 r glide;
#X msg 690 480 create 0 0 1 \, mode 2;
#X obj 600 510 param Glide;
#X obj 600 540 s glide-in;
