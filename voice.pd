#N canvas 0 0 760 480 12;
#X obj 20 20 inlet;
#X obj 20 50 unpack f f;
#X obj 200 80 t b f;
#X obj 20 80 f;
#X obj 200 110 mtof;
#X obj 200 260 s \$0-freq;
#X obj 20 110 sel 0;
#X obj 70 140 / 127;
#X obj 70 170 pack f 10;
#X obj 130 140 r attack;
#X obj 20 170 f 300;
#X obj 20 140 r release;
#X msg 20 200 0 \$1;
#X obj 20 230 line~;
#X text 200 330 129 partials below: S subharmonics + root + the rest harmonics;
#X text 420 330 129 partials: S subharmonics + root + the rest harmonics;
#X obj 20 370 *~;
#X obj 20 400 outlet~;
#X obj 200 370 *~;
#X obj 200 400 outlet~;
#X obj 630 390 delay;
#X msg 680 360 stop;
#X obj 700 330 + 50;
#X obj 700 300 r release;
#X obj 200 140 t f f;
#X obj 280 170 expr max(0 \, int($f1/20) - 1);
#X obj 280 200 expr min($f1 \, int(128*$f1/max(1 \, $f1 + $f2) + 0.5));
#X obj 280 230 t f f;
#X obj 200 230 pack f f;
#X obj 420 260 f;
#X obj 420 290 s win-show;
#X obj 420 230 b;
#X text 380 110 S = number of subharmonics for this note. Audible subs = f/20 - 1 \, audible harmonics = 18000/f - 1. The 128 non-root slots are shared out in proportion \, never giving a side more than can be heard \, so high notes get more subharmonics and low notes more harmonics.;
#X obj 480 230 s \$0-on;
#X obj 600 110 spigot 1;
#X obj 600 140 spigot;
#X obj 640 80 == 0;
#X obj 600 170 s \$0-off;
#X obj 640 50 r glide;
#X obj 70 230 t f b;
#X obj 130 260 f;
#X obj 130 290 expr if($f2 != 0 \, 1 \, $f1);
#X msg 650 420 0;
#X text 600 10 glide on: the volume envelope opens in 1 ms and holds through the release (the partials fade in and out themselves) \, then resets when the voice switches off;
