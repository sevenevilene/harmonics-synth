#N canvas 0 0 760 480 12;
#X obj 20 20 inlet;
#X obj 20 50 t l l;
#X obj 200 80 list split 1;
#X obj 20 80 list split 1;
#X obj 200 110 mtof;
#X obj 200 260 s \$0-freq;
#X obj 20 110 sel 0;
#X obj 70 140 / 127;
#X obj 70 170 pack f 10;
#X obj 130 140 r attack;
#X obj 20 170 f 300;
#X obj 20 140 r release;
#X msg 20 200 0 \$1;
#X obj 20 230 line~;
#X obj 200 330 clone -s 1 partial 129 \$0;
#X text 420 330 129 partials: S subharmonics + root + the rest harmonics;
#X obj 20 370 *~;
#X obj 20 400 outlet~;
#X obj 200 370 *~;
#X obj 200 400 outlet~;
#X obj 560 450 switch~;
#X msg 560 420 1;
#X obj 630 390 delay;
#X msg 630 420 0;
#X msg 680 360 stop;
#X obj 700 330 + 50;
#X obj 700 300 r release;
#X obj 560 360 loadbang;
#X text 560 470 voice is silent -> DSP off (saves CPU);
#X obj 200 140 t f f;
#X obj 280 170 expr max(0 \, int(\$f1/20) - 1) \; max(0 \, int(18000/\$f1) - 1);
#X obj 280 200 expr min(\$f1 \, int(128*\$f1/max(1 \, \$f1 + \$f2) + 0.5));
#X obj 280 230 t f f;
#X obj 200 230 pack f f;
#X obj 420 260 f;
#X obj 420 290 s win-show;
#X obj 420 230 b;
#X text 380 110 S = number of subharmonics for this note. Audible subs = f/20 - 1 \, audible harmonics = 18000/f - 1. The 128 non-root slots are shared out in proportion \, never giving a side more than can be heard \, so high notes get more subharmonics and low notes more harmonics.;
